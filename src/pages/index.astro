---
import BaseLayout from '../layouts/BaseLayout.astro';
import { postsPerPage, site, formatDate, sortPosts, type BlogPost } from '../data/site';

const modules = import.meta.glob<BlogPost>('../content/posts/*.md', { eager: true });
const posts = sortPosts(
  Object.entries(modules).map(([path, post]) => ({
    ...post,
    url: `/posts/${path.split('/').pop()?.replace('.md', '')}/`
  }))
);
const pagePosts = posts.slice(0, postsPerPage);
const totalPages = Math.ceil(posts.length / postsPerPage);
const pageUrl = (page: number) => (page === 1 ? '/' : `/page/${page}/`);
---

<BaseLayout>
  <section class="content-section" aria-labelledby="latest-posts">
    <h1 class="visually-hidden">{site.title}</h1>
    <div class="post-list">
      {
        pagePosts.map((post) => (
          <article class="post-card">
            <a href={post.url}>
              <time datetime={post.frontmatter.pubDate}>
                {formatDate(post.frontmatter.pubDate)}
              </time>
              <h3>{post.frontmatter.title}</h3>
              <p>{post.frontmatter.description}</p>
            </a>
          </article>
        ))
      }
    </div>
    {
      totalPages > 1 ? (
        <nav class="pagination" aria-label="글 목록 페이지">
          <span aria-hidden="true">이전</span>
          <ol>
            {Array.from({ length: totalPages }, (_, index) => index + 1).map((page) => (
              <li>
                {page === 1 ? (
                  <span aria-current="page">1</span>
                ) : (
                  <a href={pageUrl(page)} aria-label={`${page}페이지로 이동`}>{page}</a>
                )}
              </li>
            ))}
          </ol>
          <a href={pageUrl(2)}>다음</a>
        </nav>
      ) : null
    }
  </section>
</BaseLayout>
