---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../data/site';

const skills = [
  {
    name: 'TypeScript',
    icon: '/icons/typescript.svg'
  },
  {
    name: 'Node.js',
    icon: '/icons/nodejs.svg'
  },
  {
    name: 'Express',
    icon: '/icons/express.svg'
  },
  {
    name: 'Nest.js',
    icon: '/icons/nestjs.svg'
  },
  {
    name: 'PostgreSQL',
    icon: '/icons/postgresql.svg'
  },
  {
    name: 'AWS',
    icon: '/icons/aws.svg'
  },
  {
    name: 'Redis',
    icon: '/icons/redis.svg'
  }
];

const tools = [
  {
    name: 'Docker',
    icon: '/icons/docker.svg'
  },
  {
    name: 'GitHub Actions',
    icon: '/icons/github-actions.svg'
  },
  {
    name: 'TypeORM',
    icon: '/icons/typeorm.svg'
  },
  {
    name: 'Jest',
    icon: '/icons/jest.svg'
  }
];

const interests = [
  {
    name: 'Spring',
    icon: '/icons/spring.svg'
  },
  {
    name: 'Kubernetes',
    icon: '/icons/kubernetes.svg'
  }
];

const links = [
  {
    label: 'Blog',
    href: site.url,
    display: site.url.replace('https://', ''),
    external: true
  },
  {
    label: 'GitHub',
    href: 'https://github.com/ohtaehyun',
    display: 'github.com/ohtaehyun',
    external: true
  },
  {
    label: 'Contact',
    href: 'mailto:othdev95@gmail.com',
    display: 'othdev95@gmail.com',
    external: false
  }
];
---

<BaseLayout title="소개" description={`${site.author}의 블로그 소개`}>
  <section class="page-section about-section">
    <h1>About Me</h1>
    <p>안녕하세요. 백엔드 개발자 오태현입니다.</p>
    <p>
      Node.js와 Nest.js를 중심으로 백엔드 서비스를 개발해 왔습니다.
    </p>
    <p>
      단순히 동작하는 코드를 넘어, 규칙과 책임이 어디에 위치해야 유지보수하기 좋은지 고민합니다.
    </p>
  </section>

  <section class="skills-section" aria-labelledby="skills-heading">
    <div class="section-heading">
      <h2 id="skills-heading">Core</h2>
    </div>
    <ul class="skill-grid">
      {
        skills.map((skill) => (
          <li class="skill-card">
            <img src={skill.icon} alt="" width="44" height="44" loading="lazy" />
            <span>{skill.name}</span>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="tools-section" aria-labelledby="tools-heading">
    <div class="section-heading">
      <h2 id="tools-heading">Also Used</h2>
    </div>
    <ul class="tool-grid">
      {
        tools.map((tool) => (
          <li class="skill-card">
            <img src={tool.icon} alt="" width="44" height="44" loading="lazy" />
            <span>{tool.name}</span>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="interests-section" aria-labelledby="interests-heading">
    <div class="section-heading">
      <h2 id="interests-heading">Interested In</h2>
    </div>
    <ul class="interest-grid">
      {
        interests.map((interest) => (
          <li class="skill-card">
            <img src={interest.icon} alt="" width="44" height="44" loading="lazy" />
            <span>{interest.name}</span>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="links-section" aria-labelledby="links-heading">
    <div class="section-heading">
      <h2 id="links-heading">Links</h2>
    </div>
    <ul class="link-grid">
      {
        links.map((link) => (
          <li>
            <a
              class="link-card"
              href={link.href}
              target={link.external ? '_blank' : undefined}
              rel={link.external ? 'noreferrer' : undefined}
            >
              <span>{link.label}</span>
              <span>{link.display}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>
</BaseLayout>
